<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground — white heart silhouette with a calendar-page
    detail (two top "binding" rings and a horizontal divider line).
    Designed inside the 66×66 "safe area" centred in the 108×108 viewport
    (Android's adaptive-icon safe zone), so no element gets clipped by any
    launcher mask shape.

    Why a heart + calendar motif:
      MyCutieSchedule is a personal pink calendar app. The heart carries the
      "cutie" tone, the small notches & line on top read as a planner page.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Main heart shape, drawn in white. Centred at ~(54,60). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,85 C54,85 26,68 26,46 C26,36 34,30 42,30 C48,30 52,33 54,38 C56,33 60,30 66,30 C74,30 82,36 82,46 C82,68 54,85 54,85 Z" />

    <!-- Small horizontal "calendar line" near the top of the heart, drawn
         in soft Pink100 (#FFD6E8) so it reads as a printed planner detail
         without breaking the heart silhouette. -->
    <path
        android:fillColor="#FFD6E8"
        android:pathData="M40,52 L68,52 L68,55 L40,55 Z" />

    <!-- Two binding "rings" above the line — like a notebook's spiral. -->
    <path
        android:fillColor="#FFD6E8"
        android:pathData="M45,45 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 z" />
    <path
        android:fillColor="#FFD6E8"
        android:pathData="M63,45 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 z" />
</vector>
