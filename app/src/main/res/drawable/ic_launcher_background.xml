<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background — brand pink with a subtle softer-pink radial
    glow centred near the top so the foreground heart pops against a slightly
    deeper bottom. 108×108 viewport is the standard adaptive icon canvas;
    the launcher masks it into circles, squircles, etc.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Solid base — Pink400 (#FF4DA6) — vibrant brand pink that survives
         the launcher's various adaptive-icon masks (circle / squircle / drop). -->
    <path
        android:fillColor="#FF4DA6"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Soft Pink300 (#FF80C0) highlight in upper-left for depth.
         Drawn as an off-screen large circle for a gentle gradient effect. -->
    <path
        android:fillColor="#FF80C0"
        android:fillAlpha="0.55"
        android:pathData="M-20,-20 m-30,0 a90,90 0 1,0 180,0 a90,90 0 1,0 -180,0 z" />
</vector>
